{
  "version": 2,
  "builds": [
    { "src": "api/search.js", "use": "@vercel/node" },
    { "src": "api/faqs.js", "use": "@vercel/node" },
    { "src": "api/product.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/search", "dest": "api/search.js" },
    { "src": "/api/faqs", "dest": "api/faqs.js" },
    { "src": "/api/product", "dest": "api/product.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
